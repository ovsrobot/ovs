######################################################################
RECONNECT_CHECK([passive mode],
  [passive
enable

# Start listening.
timeout
run
listening

# Listening never times out.
timeout
run

# Listening failed (accept() returned funny error?).  Back off and try again.
listen-error 0
timeout
run
listening

# Connection accepted.
connected
activity
advance 1000
activity

# Connection times out.
timeout
receive-attempted LLONG_MAX
timeout
run
timeout
run
disconnected

# Start listening again.
timeout
run
listening
],
  [### t=1000 ###
passive
enable
  in BACKOFF for 0 ms (0 ms backoff)

# Start listening.
timeout
  advance 0 ms
run
